---
// Every page goes through this layout: <head> (title, description, canonical, hreflang,
// Open Graph), header, <main>, footer, the language scripts and the menu and pause script. The 404 page (no `page`) is
// bilingual: no canonical or alternates, noindex, both home pages in the switch.
import '../styles/tokens.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LangRoot from '../components/LangRoot.astro';
import LangMemory from '../components/LangMemory.astro';
import UiScript from '../components/UiScript.astro';
import { type Lang, type PageId, LOCALES, DEFAULT_LANG, OG_LOCALE, OTHER, absolute, pagePath } from '../i18n';
import { UI } from '../i18n/ui';
import ogSource from '../assets/maps/pentes-izoard.webp';

import type { Preload } from '../lib/images';
interface Props {
  lang: Lang;
  /** Page id (navigation, switch, alternates); undefined on the 404 page. */
  page?: PageId;
  title: string;
  description: string;
  /** Preload of the hero image (the page's largest paint). */
  preload?: Preload[];
  /** Class of <body> (the home page: `home`). */
  bodyClass?: string;
}
const { lang, page, title, description, preload = [], bodyClass } = Astro.props;
const ui = UI[lang];
const canonical = page ? absolute(pagePath(page, lang)) : undefined;
const og = await getImage({ src: ogSource, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="color-scheme" content="light dark" />
<link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
{page ? (
  <Fragment>
<link rel="canonical" href={canonical} />
{LOCALES.map((l) => <link rel="alternate" hreflang={l} href={absolute(pagePath(page, l))} />)}
<link rel="alternate" hreflang="x-default" href={absolute(pagePath(page, DEFAULT_LANG))} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Traces Blanches" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={absolute(og.src)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={OG_LOCALE[lang]} />
<meta property="og:locale:alternate" content={OG_LOCALE[OTHER[lang]]} />
<meta name="twitter:card" content="summary_large_image" />
  </Fragment>
) : <meta name="robots" content="noindex" />}
{preload.map((p) => <link rel="preload" as="image" imagesrcset={p.srcset} imagesizes={p.sizes} type={p.type} media={p.media} fetchpriority="high" />)}
<meta name="theme-color" content="#f6f8fb" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0d141b" media="(prefers-color-scheme: dark)" />
</head>
<body class={bodyClass}>
{/* First in <body>: after the CSP <meta> that Astro adds at the end of <head>, before anything is drawn. */}
{page === 'home' && lang === DEFAULT_LANG && <LangRoot />}
<a class="skip" href={`#${ui.mainId}`}>{ui.skip}</a>
<Header lang={lang} page={page} />
<main id={ui.mainId}>
<slot name="hero" />
<div class="wrap">
<slot />
</div>
</main>
<Footer lang={lang} bilingual={!page} />
<LangMemory />
<UiScript />
</body>
</html>
