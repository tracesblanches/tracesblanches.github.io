---
// "Get the app" (/get.html, /fr/obtenir.html; formerly "Price"): the release, coming winter 2027,
// at a modest price with no subscription and no ads (no amount is announced), what it gives
// access to, and the honest state: the app is not in a store yet, all the work is public on
// GitHub. No store link until the app is in one. The release block uses the poster palette
// (night blue, peach snow, white) with the badger illustration.
import Base from '../layouts/Base.astro';
import Img from './Img.astro';
import { type Lang, REPO, href } from '../i18n';
import { NOTIFY_ANCHOR, UI } from '../i18n/ui';
import badger from '../assets/visuels/obtenir.webp';
import { typo } from '../lib/typo';

interface Props { lang: Lang }
const { lang } = Astro.props;
const a = (url: string, text: string) => `<a href="${url}" rel="noopener">${text}</a>`;

const T = {
  en: {
    title: 'Get the app · Traces Blanches',
    description: 'The Traces Blanches Android app comes out in winter 2027, at a modest price, with no subscription and no ads. Until then, all the work is public on GitHub.',
    h1: 'Get the app',
    lead: 'The Android app comes out in winter 2027. Until then, all the work is public on GitHub; the button below lets you follow its release.',
    label: 'The Android app',
    amount: 'Coming winter 2027',
    once: `At a modest price, with no subscription and no ads. Until then, ${a(REPO, 'all the work is public on GitHub')}.`,
    alt: 'Illustration: a badger walks on fresh snow at the edge of a dark forest, its tracks behind it.',
    includesTitle: 'What it gives access to',
    includes: [
      { h: 'All of France', p: 'The 219 Nordic ski areas of the census, the Nordic backcountry areas and the great traverses.' },
      { h: 'Every pack', p: 'Download as many areas as you like. Each one then works without a network.' },
      { h: 'The updates', p: 'The packs are rebuilt every day; new versions of the app come at no extra cost.' },
      { h: 'No ads', p: 'No advertising and no audience tracking in the app.' },
      { h: 'No subscription', p: 'Nothing renews, nothing expires.' },
      { h: 'Your data stays with you', p: 'Your position, your tracks and your day plans stay on your phone.' },
    ],
    notesLabel: 'About the price',
    whyTitle: 'Why a price',
    why: 'The map lives on your phone, and the route is worked out there too. What costs money is the server that builds and updates the packs of the whole of France every day. The price covers that hosting.',
    codeTitle: 'All the work is public',
    code: `Anyone can ${a(REPO, 'look at all the work on the app')} and check what it does.`,
    faqTitle: 'Questions',
    faq: [
      { q: 'When can I install it?', a: 'In winter 2027. The button above lets you follow its release.' },
      { q: 'Is there an iPhone version?', a: 'No. The app runs on Android phones, from Android 10.' },
      { q: 'Can I see the work before then?', a: `Yes. ${a(REPO, 'Everything is public')}: what the app does, how the packs are built, and the open questions.` },
    ],
    more: 'Every feature, explained',
  },
  fr: {
    title: "Obtenir l'app · Traces Blanches",
    description: "L'app Android Traces Blanches sort à l'hiver 2027, à un prix modique, sans abonnement ni publicité. D'ici là, tout le travail est consultable sur GitHub.",
    h1: "Obtenir l'app",
    lead: "L'app Android sort à l'hiver 2027. D'ici là, tout le travail est consultable sur GitHub ; le bouton ci-dessous permet de suivre sa sortie.",
    label: "L'app Android",
    amount: 'Sortie hiver 2027',
    once: `À un prix modique, sans abonnement ni publicité. D'ici là, ${a(REPO, 'tout le travail est consultable sur GitHub')}.`,
    alt: "Illustration : un blaireau marche dans la neige fraîche au bord d'une forêt sombre, ses traces derrière lui.",
    includesTitle: 'Ce que cela donne',
    includes: [
      { h: 'Toute la France', p: 'Les 219 domaines nordiques du recensement, les domaines de ski de randonnée nordique et les grandes traversées.' },
      { h: 'Tous les packs', p: 'Téléchargez autant de domaines que vous voulez. Chacun marche ensuite sans réseau.' },
      { h: 'Les mises à jour', p: "Les packs sont reconstruits chaque jour ; les nouvelles versions de l'app arrivent sans supplément." },
      { h: 'Aucune publicité', p: "Ni publicité, ni mesure d'audience dans l'app." },
      { h: 'Aucun abonnement', p: "Rien ne se renouvelle, rien n'expire." },
      { h: 'Vos données restent chez vous', p: 'Votre position, vos traces et vos plans de journée restent sur votre téléphone.' },
    ],
    notesLabel: 'À propos du prix',
    whyTitle: 'Pourquoi un prix',
    why: "La carte vit sur votre téléphone, et l'itinéraire s'y calcule aussi. Ce qui coûte, c'est le serveur qui construit et met à jour chaque jour les packs de toute la France. Le prix couvre cet hébergement.",
    codeTitle: 'Tout le travail est public',
    code: `Chacun peut ${a(REPO, "consulter tout le travail sur l'app")} et vérifier ce qu'elle fait.`,
    faqTitle: 'Questions',
    faq: [
      { q: "Quand pourrai-je l'installer ?", a: "À l'hiver 2027. Le bouton plus haut permet de suivre sa sortie." },
      { q: 'Existe-t-il une version iPhone ?', a: "Non. L'app tourne sur les téléphones Android, à partir d'Android 10." },
      { q: "Peut-on voir le travail d'ici là ?", a: `Oui. ${a(REPO, 'Tout est public')} : ce que fait l'app, comment les packs sont construits, et les questions ouvertes.` },
    ],
    more: 'Toutes les fonctionnalités, expliquées',
  },
}[lang];
// The badger beside the release block on a wide screen (about 44 % of the 68rem column), above it on a phone.
const t = (x: string) => typo(lang, x);
const ART = '(min-width: 68rem) 29rem, (min-width: 48rem) 44vw, calc(100vw - 2.2rem)';
---
<Base lang={lang} page="get" title={T.title} description={t(T.description)}>
<div class="get">
<header class="get-head text">
<h1>{T.h1}</h1>
<p class="lead">{t(T.lead)}</p>
</header>

<section class="buy on-night" aria-labelledby="buy-amount">
<div class="buy-art"><Img src={badger} alt={T.alt} sizes={ART} eager /></div>
<div class="buy-body">
<p class="buy-label">{T.label}</p>
<p id="buy-amount" class="buy-amount">{T.amount}</p>
<p class="buy-once" set:html={t(T.once)} />
<div class="actions"><a class="btn primary big" href={NOTIFY_ANCHOR}>{UI[lang].notify}</a></div>
</div>
</section>

<section class="get-section" aria-labelledby="includes">
<h2 id="includes" class="big">{T.includesTitle}</h2>
<div class="includes">
{T.includes.map((x) => <div class="include"><h3>{x.h}</h3><p>{t(x.p)}</p></div>)}
</div>
</section>

<section class="get-section get-notes" aria-label={T.notesLabel}>
<div class="note"><h2 id="why">{T.whyTitle}</h2><p>{t(T.why)}</p></div>
<div class="note"><h2 id="open-code">{T.codeTitle}</h2><p set:html={t(T.code)} /></div>
</section>

<section class="get-section text" aria-labelledby="price-faq">
<h2 id="price-faq" class="big">{T.faqTitle}</h2>
{T.faq.map((f) => <details><summary>{t(f.q)}</summary><p set:html={t(f.a)} /></details>)}
<p><a href={href('features', lang)}>{T.more}</a></p>
</section>
</div>
</Base>
