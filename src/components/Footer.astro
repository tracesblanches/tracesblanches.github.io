---
// Footer: the data credits (their licences ask for them to be reachable), the one link to the
// source code (everything technical lives in the repository), the site licence and where to
// ask. The 404 page (bilingual) carries both languages.
import { type Lang, pagePath, REPO } from '../i18n';
import { UI, ISSUES } from '../i18n/ui';

interface Props { lang: Lang; bilingual?: boolean }
const { lang, bilingual = false } = Astro.props;
const langs: Lang[] = bilingual ? ['en', 'fr'] : [lang];
---
<footer><div class="wrap">
{langs.map((l) => {
  const f = UI[l].footer;
  return (
    <p lang={bilingual && l !== lang ? l : undefined}><a href={pagePath('credits', l)}>{f.credits}</a>. {f.code} <a href={REPO}>{f.source}</a>. {f.site} {f.ask} <a href={ISSUES}>{f.askLink}</a>.</p>
  );
})}
</div></footer>
