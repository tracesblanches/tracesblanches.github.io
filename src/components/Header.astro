---
// Header: the logo (Logo.astro), the FR | EN switch to the page's counterpart, the GitHub link,
// and the page links. On the 404 page (`page` undefined) the switch leads to both home pages and
// there are no page links.
import Logo from './Logo.astro';
import { type Lang, type PageId, NAV, LANG_NAMES, pagePath } from '../i18n';

// FR first, then EN, as on the hand-written site.
const SWITCH: Lang[] = ['fr', 'en'];
import { UI, ORG } from '../i18n/ui';

interface Props { lang: Lang; page?: PageId }
const { lang, page } = Astro.props;
const ui = UI[lang];
---
<header class="top"><div class="wrap">
<a class="brand" href={pagePath('home', lang)}><Logo /></a>
<div class="tools">
<div class="lang" role="group" aria-label={ui.langLabel}>{SWITCH.map((l) => (
  page && l === lang
    ? <span aria-current="true">{l.toUpperCase()}</span>
    : <a href={pagePath(page ?? 'home', l)} hreflang={l} lang={l === lang ? undefined : l} data-lang={l} aria-label={`${l.toUpperCase()}, ${LANG_NAMES[l]}`}>{l.toUpperCase()}</a>
))}</div>
<a class="gh" href={ORG} aria-label={ui.onGitHub}><svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg></a>
</div>
{page && (
<nav class="site" aria-label={ui.navLabel}><ul>
{NAV.map((id) => <li><a href={pagePath(id, lang)} aria-current={id === page ? 'page' : undefined}>{ui.nav[id as Exclude<PageId, 'home'>]}</a></li>)}
</ul></nav>
)}
</div></header>
