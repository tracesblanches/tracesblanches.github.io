---
// The home page, in English or French (text in src/copy/home.ts, pictures in
// src/data/visuals.ts): the hero, the whole of France with its large map, a day on skis in three
// scenes (each feature is explained on the features page), safety, nature, the purchase, a few
// questions; the layout closes it with the release band (Notify.astro). Paragraphs are HTML
// strings because they carry links to the services and papers they name.
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Img from './Img.astro';
import { type Lang, href } from '../i18n';
import { HOME } from '../copy/home';
import { RELEASE_ISSUE, UI } from '../i18n/ui';
import { visual, type Slot } from '../data/visuals';
import { heroPreload } from '../lib/images';
import { typo } from '../lib/typo';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = HOME[lang];
const t = (x: string) => typo(lang, x);
const slides = (['accueil', 'accueil-2'] as const).map(visual).filter((v) => v.image)
  .map((v) => ({ image: v.image!, portrait: v.portrait, alt: v.alt[lang], credit: v.credit?.[lang] }));
const preload = slides.length ? await heroPreload(slides[0].image, slides[0].portrait) : [];
const SCENES: Slot[] = ['matin', 'piste', 'retour'];
const tag = (t: string) => (t === 'today' ? { cls: 'done', label: c.today } : { cls: 'plan', label: c.planned });
// A picture beside a text column: drawn at about 60 % of the 68rem column from 48rem, else full width.
const SIDE = '(min-width: 68rem) 38rem, (min-width: 48rem) 56vw, calc(100vw - 2.2rem)';
// The map of France, in its night band: the window minus the text column from 64rem (56rem at most), else full width.
const WIDE = '(min-width: 64rem) min(56rem, calc(50vw + 34rem - 1.1rem - 24rem - 3rem - 3vw)), calc(100vw - 2.2rem)';
const fr = visual('france');
---
<Base lang={lang} page="home" title={c.title} description={t(c.description)} preload={preload} bodyClass="home">
{slides.length > 0 && <Hero slot="hero" slides={slides} eyebrow={c.eyebrow} title={c.h1} lead={c.lead} cta={{ href: RELEASE_ISSUE, label: UI[lang].notify }} pause={c.pause} />}

<section class="france on-night" aria-labelledby="france">
<div class="france-in">
<div class="france-text">
<h2 id="france" class="big">{c.franceTitle}</h2>
{c.france.map((x) => <p set:html={t(x)} />)}
</div>
{fr.image && (
  <figure class="france-map">
    <Img src={fr.image} alt={fr.alt[lang]} sizes={WIDE} />
    {(fr.caption || fr.credit) && <figcaption>{typo(lang, fr.caption?.[lang])}{fr.credit && <span class="credit">{typo(lang, fr.credit[lang])}</span>}</figcaption>}
  </figure>
)}
</div>
</section>

<section class="section" aria-labelledby="day">
<h2 id="day" class="big">{c.dayTitle}</h2>
<p class="lead text">{t(c.dayIntro)} <a href={href('features', lang)}>{c.dayLink}</a></p>
{c.scenes.map((s, i) => {
  const v = visual(SCENES[i]);
  return (
    <article class:list={['scene', { flip: i % 2 === 1 }]}>
      <div class="scene-text">
        <p class="step">{i + 1}</p>
        <h3>{t(s.title)}</h3>
        {s.text.map((x) => <p set:html={t(x)} />)}
        <p>{s.tags.map((t) => <span class:list={['tag', tag(t).cls]}>{tag(t).label}</span>)}</p>
      </div>
      {v.image && (
        <figure class="scene-art">
          <Img src={v.image} alt={v.alt[lang]} sizes={SIDE} />
          {(v.caption || v.credit) && <figcaption>{typo(lang, v.caption?.[lang])}{v.credit && <span class="credit">{typo(lang, v.credit[lang])}</span>}</figcaption>}
        </figure>
      )}
    </article>
  );
})}
</section>

{([['securite', 'safety', c.safetyTitle, c.safety, { href: href('faq', lang, 'avalanches'), label: c.safetyLink }],
   ['nature', 'nature', c.natureTitle, c.nature, { href: href('privacy', lang, lang === 'fr' ? 'telephone' : 'phone'), label: c.natureLink }]] as const).map(([slot, id, title, paras, link], i) => {
  const v = visual(slot);
  return (
    <section class:list={['section', 'scene', { flip: i % 2 === 0, solo: !v.image }]} aria-labelledby={id}>
      <div class="scene-text">
        <h2 id={id} class="big">{title}</h2>
        {paras.map((x) => <p set:html={t(x)} />)}
        <p><a href={link.href}>{link.label}</a></p>
      </div>
      {v.image && (
        <figure class="scene-art">
          <Img src={v.image} alt={v.alt[lang]} sizes={SIDE} />
          {(v.caption || v.credit) && <figcaption>{typo(lang, v.caption?.[lang])}{v.credit && <span class="credit">{typo(lang, v.credit[lang])}</span>}</figcaption>}
        </figure>
      )}
    </section>
  );
})}

<section class="section text" aria-labelledby="get">
<div class="price">
<h2 id="get" class="big">{c.getTitle}</h2>
<p set:html={t(c.get)} />
<p><a href={href('get', lang)}>{t(c.getLink)}</a></p>
</div>
</section>

<section class="section text" aria-labelledby="questions">
<h2 id="questions" class="big">{c.faqTitle}</h2>
{c.faq.map((f) => (
  <details><summary>{t(f.q)}</summary><p set:html={t(f.a)} /></details>
))}
<p><a href={href('faq', lang)}>{c.faqMore}</a></p>
</section>

</Base>
