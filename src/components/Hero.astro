---
// The home hero: full width, the rest of the first screen under the header, the picture
// covering it, a dark gradient from the left and the bottom under the text (global.css, "home
// hero"). Eyebrow, title, one sentence, one button. The picture is the page's largest paint:
// loaded at once with high priority, and preloaded by the page (heroPreload in lib/images.ts,
// passed to Base). On a screen held upright it shows the portrait file when there is one, else
// the right part of the picture (PORTRAIT_CROP). The credit of the picture sits in the bottom
// right corner.
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';
import { coverSizes, PORTRAIT_CROP } from '../lib/images';

interface Props {
  image: ImageMetadata;
  portrait?: ImageMetadata;
  alt: string;
  eyebrow?: string;
  title: string;
  lead: string;
  cta: { href: string; label: string; hreflang?: string };
  credit?: string;
}
const { image, portrait, alt, eyebrow, title, lead, cta, credit } = Astro.props;
---
<section class="hero on-night" aria-labelledby="hero-title">
<div class="hero-art">
<Img src={image} alt={alt} eager sizes={coverSizes(image.width / image.height)}
  portrait={portrait} portraitCrop={portrait ? undefined : PORTRAIT_CROP}
  portraitSizes={coverSizes(portrait ? portrait.width / portrait.height : PORTRAIT_CROP.ratio)} />
</div>
<div class="wrap hero-body">
<div class="hero-text">
{eyebrow && <p class="eyebrow">{eyebrow}</p>}
<h1 id="hero-title">{title}</h1>
<p class="hero-lead">{lead}</p>
<div class="actions"><a class="btn primary big" href={cta.href} hreflang={cta.hreflang}>{cta.label}</a></div>
</div>
</div>
{credit && <p class="hero-credit">{credit}</p>}
</section>
