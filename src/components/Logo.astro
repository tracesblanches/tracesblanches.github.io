---
// The project's logo: the ONE place that draws it. The mark validated by the project
// (src/assets/brand/logo.png, from Traces_Blanches_Logo_Lievre_Lune_2048.png: the hare under the
// moon, corners made transparent) and the name set in text. Keep the name as text (or as an accessible name) so that
// the link reads "Traces Blanches". The header styles `.logo` (global.css, section "header").
// The favicons (public/favicon.png, public/apple-touch-icon.png) come from the same picture.
import { Image } from 'astro:assets';
import mark from '../assets/brand/logo.png';
---
<span class="logo"><Image src={mark} width={28} height={28} densities={[1, 2, 3]} alt="" loading="eager" />Traces Blanches</span>
