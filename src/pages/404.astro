---
// Bilingual 404 page (GitHub Pages serves dist/404.html for any unknown address): absolute links.
import Base from '../layouts/Base.astro';
---
<Base lang="en" title="Page not found · Page introuvable · Traces blanches" description="This page does not exist on the Traces blanches website. Cette page n'existe pas sur le site de Traces blanches.">
<div class="text">
<h1>Page not found</h1>
<p class="lead">This address matches no page on the site. The page may have been renamed.</p>
<div class="actions">
<a class="btn primary" href="/">Go to the home page</a>
<a class="btn secondary" href="/faq.html">Read the FAQ</a>
</div>

<section lang="fr" aria-labelledby="introuvable">
<h2 id="introuvable">Page introuvable</h2>
<p class="lead">Cette adresse ne correspond à aucune page du site. La page a peut-être changé de nom.</p>
<div class="actions">
<a class="btn primary" href="/fr/">Revenir à l'accueil</a>
<a class="btn secondary" href="/fr/faq.html">Lire la FAQ</a>
</div>
</section>
</div>
</Base>
